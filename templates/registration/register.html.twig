{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center bg-gray-900">

    <div class="w-full max-w-md bg-gray-800 rounded-xl shadow-2xl p-8 border border-red-900">

        <h1 class="text-3xl font-bold text-center text-red-500 mb-8">
            Crear una cuenta
        </h1>

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}

            <div class="space-y-6">

                <div>
                    {{ form_label(registrationForm.username, null, {
                        label_attr: {'class': 'block text-gray-300 mb-2 font-medium'}
                    }) }}

                    {{ form_widget(registrationForm.username, {
                        attr: {
                            class: 'w-full rounded-lg bg-gray-700 border border-gray-600 text-white px-4 py-3 focus:border-red-500 focus:ring-red-500'
                        }
                    }) }}

                    {{ form_errors(registrationForm.username) }}
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword, 'Contraseña', {
                        label_attr: {'class': 'block text-gray-300 mb-2 font-medium'}
                    }) }}

                    {{ form_widget(registrationForm.plainPassword, {
                        attr: {
                            class: 'w-full rounded-lg bg-gray-700 border border-gray-600 text-white px-4 py-3 focus:border-red-500 focus:ring-red-500'
                        }
                    }) }}

                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

            
                {# --------------- #}
                {# 

                #}
                {# --------------- #}

                <button
                    type="submit"
                    class="w-full bg-red-800 hover:bg-red-700 text-white px-8 py-3 rounded-lg font-semibold transition shadow-md shadow-red-950/50">
                    Crear cuenta
                </button>

                <div class="text-center pt-2">
                    <a
                        href="{{ path('app_login') }}"
                        class="text-gray-400 hover:text-gray-200 transition">
                        ← Volver al inicio de sesión
                    </a>
                </div>
            </div>

        {{ form_end(registrationForm) }}

    </div>

</div>


{% endblock %}
