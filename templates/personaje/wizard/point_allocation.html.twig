{% extends 'base.html.twig' %}

{% block body %}

<div class="max-w-4xl mx-auto bg-zinc-900 rounded-xl shadow-2xl p-8 border border-zinc-700">

    {% for message in app.flashes('error') %}
        <div style="color:red;">
            {{ message }}
        </div>
    {% endfor %}

    {# Aviso puntos repartidos mal #}
    <p id="mensaje_error" style="color:red;">
    </p>

    <form method="post"> 

        <div class="mb-8 text-lg text-zinc-300">
            Distribución actual:
            <span
                id="distribucion"
                class="font-bold text-red-300">
            </span>
        </div>

        <h1 class="text-4xl font-bold text-red-200 mb-2">
            {{ titulo }}
        </h1>

        <p class="text-zinc-400 mb-8">
            Reparte los puntos de tu personaje.
        </p>

        {% for categoria, lista in rasgosAgrupados %}

            <h2 class="text-2xl font-semibold text-red-300 mt-8 mb-4 border-b border-zinc-700 pb-2">
                {{ categoria }}
                (<span id="{{ categoria|lower }}_actual">0</span>)
            </h2>


            {% for item in lista %}

            <div class="point-row flex items-center justify-between py-3 border-b border-zinc-800">

                <span class="text-zinc-200 font-medium">
                    {{ item.nombre }}
                </span>

                <div class="flex items-center gap-3">

                    <button
                        type="button"
                        class="minus-btn w-8 h-8 rounded bg-zinc-700 hover:bg-red-800 transition">
                        −
                    </button>

                    <input
                        type="number"
                        class="point-input w-12 text-center rounded bg-zinc-800 border border-zinc-600 text-white"
                        name="{{ inputName }}[{{ item.id }}]"
                        value="{{ minimo }}"
                        readonly
                        data-categoria="{{ categoria }}"
                    >

                    <button
                        type="button"
                        class="plus-btn w-8 h-8 rounded bg-zinc-700 hover:bg-red-800 transition">
                        +
                    </button>

                </div>

            </div>

            {% endfor %}

        {% endfor %}

        <script src="{{ asset('js/point_allocator.js') }}"></script>


        <script>

            initPointAllocator({
                minimo: {{ minimo }},
                base: {{ minimo }},
                maximo: {{ maximo }}
            });

        </script>

        <br>
        <br>
        <div class="mt-10 text-right">
            <button
                class="bg-red-800 hover:bg-red-700 px-8 py-3 rounded-lg font-semibold transition">
                Continuar →
            </button>
        </div>

    </form>
</div>

{% endblock %}



