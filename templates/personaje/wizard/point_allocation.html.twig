{% for message in app.flashes('error') %}
    <div style="color:red;">
        {{ message }}
    </div>
{% endfor %}

{# Aviso demasiados puntos repartidos #}
<p id="mensaje_error" style="color:red;"></p>

<form method="post"> 

<p>
Distribución actual: 
<span id="distribucion"></span>
</p>

<h1>{{ titulo }}</h1>

{% for categoria, lista in rasgosAgrupados %}

    <h2>
        {{ categoria }}
        (<span id="{{ categoria|lower }}_actual">0</span>)

    </h2>

    {% for item in lista %}

        <div class="point-row">

            {{ item.nombre }}

            <div>

                <button type="button" class="minus-btn">-</button>

                <input
                    type="number"
                    class="point-input"
                    name="{{ inputName }}[{{ item.id }}]"
                    value="{{minimo}}"
                    readonly
                    data-categoria="{{ categoria }}"
                >

                <button type="button" class="plus-btn">+</button>

            </div>

        </div>

    {% endfor %}

{% endfor %}

<script src="{{ asset('js/point_allocator.js') }}"></script>


<script>

    initPointAllocator({
        minimo: {{ minimo }},
        base: {{ minimo }},
        maximo: {{ maximo }}
    });

</script>

<br>
<br>
<button type="submit">Guardar atributos</button>

</form>