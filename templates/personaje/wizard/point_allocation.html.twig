{% extends 'base.html.twig' %}

{% block body %}

<form
    method="post"
    data-tipo-validacion="{{ tipoValidacion }}"
    data-distribucion="{{ distribucion|json_encode }}"
>

    <div class="max-w-7xl mx-auto grid lg:grid-cols-3 gap-8">

        {# Columna izquierda (2/3) #}
        <div class="lg:col-span-2">
            <div class="bg-zinc-900 rounded-xl shadow-2xl p-8 border border-zinc-700">
                <div id="formulario" class="max-w-4xl mx-auto bg-zinc-900 rounded-xl shadow-2xl p-8 border border-zinc-700">

                    <h1 class="text-4xl font-bold text-red-200 mb-2">
                        {{ titulo }}
                    </h1>

                    {% for categoria, lista in rasgosAgrupados %}

                        <h2 class="text-2xl font-semibold text-red-300 mt-8 mb-4 border-b border-zinc-700 pb-2">
                            {{ categoria }}
                            (<span id="{{ categoria|lower }}_actual">0</span>)
                        </h2>

                        {% for item in lista %}

                        <div class="point-row flex items-center justify-between py-3 border-b border-zinc-800">

                            <span class="text-zinc-200 font-medium">
                                {{ item.nombre }}
                            </span>

                            <div class="flex items-center gap-4">

                                <div class="flex gap-1 point-display">
                                    {% for i in 1..5 %}
                                        <span
                                            class="w-5 h-5 rounded-full border border-zinc-400 point-dot
                                            hover:scale-110
                                            cursor-pointer
                                            transition
                                            duration-150"
                                            data-value="{{ i }}">
                                        </span>
                                    {% endfor %}
                                </div>

                                <div class="flex items-center gap-2">
                                    <input
                                        {#
                                        type="hidden"
                                        #}
                                        value="{{ minimo }}"
                                        class="point-input"
                                        name="{{ inputName }}[{{ item.id }}]"
                                        data-categoria="{{ categoria }}"
                                        readonly
                                    >

                                    <button type="button" class="minus-btn w-12 h-12 text-2xl font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full flex items-center justify-center border border-gray-300 transition-colors shadow-sm">−</button>
                                    <button type="button" class="plus-btn w-12 h-12 text-2xl font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full flex items-center justify-center border border-gray-300 transition-colors shadow-sm">+</button>
                                    

                                </div>

                            </div>
                        </div>

                        {% endfor %}

                    {% endfor %}

                </div>
            </div>
        </div>

        {# Columna derecha (1/3) #}
        <aside class="sticky top-6 self-start">
            <div class="bg-zinc-900 rounded-xl border border-zinc-700 p-6">

                <h2 class="text-xl font-bold text-red-300 mb-4">
                    Guía
                </h2>

                <div id="dinamicos">
                    <div id="regla info" class="mb-6 rounded-lg border border-zinc-700 bg-zinc-800 p-4">
                        <p class="text-zinc-400 mb-2">
                            Instrucciones de distribución:
                        </p>
                        <p class="text-zinc-300">
                            {{ regla }}
                        </p>
                    </div>

                    <div id="mensajes info" class="mb-8 text-lg text-zinc-300">
                        <span id="distribucion" class="font-bold text-red-300"></span>

                        {# Aviso puntos repartidos mal #}

                        <p id="mensaje_error" style="color:red;"></p>

                        {% for message in app.flashes('error') %}
                            <div style="color:red;">
                                {{ message }}
                            </div>
                        {% endfor %}
                    </div>

                    <div id="continuar" class="mt-6">
                        <p id="mensaje_validacion" class="mb-3 text-sm font-semibold"></p>
                        <button
                            id="btn-continuar"
                            type="submit"
                            class="w-full bg-red-800 hover:bg-red-700 px-8 py-3 rounded-lg font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Continuar →
                        </button>
                    </div>
                </div>
            </div>
        </aside>

    </div>

    <script src="{{ asset('js/point_allocator.js') }}"></script>

    <script>
        initPointAllocator({
            minimo: {{ minimo }},
            base: {{ minimo }},
            maximo: {{ maximo }}
        });
    </script>
</form>


{% endblock %}