{% extends 'base.html.twig' %}

{% block body %}

<div class="min-h-screen bg-gray-100">

    <div class="max-w-7xl mx-auto px-6 py-8">

        <a href="{{ path('app_personaje_index') }}"
            class="inline-flex items-center text-red-700 hover:text-red-900 font-medium mb-6">
            ← Volver a mis personajes
        </a>

        {# ==============================
           CABECERA DEL PERSONAJE
           ============================== #}

        <section class="bg-white rounded-xl shadow-lg p-8 mb-8">

            <div class="flex justify-between items-start">

                <div>

                    <h1 class="text-5xl font-serif text-red-900 mb-4">
                        {{ personaje.nombre }}
                    </h1>

                    <div class="flex gap-8 text-lg">

                        <div>
                            <span class="font-semibold">Clan:</span>
                            <span class="text-red-700">
                                {{ personaje.clan.nombre }}
                            </span>
                        </div>

                        <div>
                            <span class="font-semibold">
                                Experiencia:
                            </span>
                            {{ personaje.experiencia }}
                        </div>

                    </div>

                </div>

                {# Aquí podremos colocar más adelante
                   el símbolo del clan o una ilustración #}

                <div class="text-gray-300 text-7xl">
                    🦇
                </div>

            </div>

        </section>

        {# ==========
           ATRIBUTOS
           ========== #}

        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Atributos
            </h2>

            {% set categorias = ['Fisico','Social','Mental'] %}

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                {% for cat in categorias %}

                    <div>

                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            {{ cat }}
                        </h3>

                        <div class="space-y-3">

                            {% for pa in personaje.personajeAtributos %}

                                {% if pa.atributo.categoria == cat %}

                                    <div class="flex justify-between items-center">

                                        <span class="text-gray-700">
                                            {{ pa.atributo.nombre }}
                                        </span>


                                        <div class="flex gap-1">

                                            {% for i in 1..5 %}

                                                {% if i <= pa.nivel %}
                                                    {# Puntos como circulitos #}
                                                    <span class="inline-block w-4 h-4 rounded-full bg-black"></span>

                                                {% else %}

                                                    <span class="inline-block w-4 h-4 rounded-full border border-black"></span>

                                                {% endif %}

                                            {% endfor %}

                                        </div>
                                    </div>

                                {% endif %}

                            {% endfor %}

                        </div>

                    </div>

                {% endfor %}

            </div>

        </section>


        {# ==========
           HABILIDADES
           ========== #}

        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Habilidades
            </h2>

            {% set categorias = ['Talentos','Tecnicas','Conocimientos'] %}

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                {% for cat in categorias %}

                    <div>

                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            {{ cat }}
                        </h3>

                        <div class="space-y-3">

                            {% for ph in personaje.personajeHabilidades %}

                                {% if ph.habilidad.categoria == cat %}

                                    <div class="flex justify-between items-center">

                                        <span class="text-gray-700">
                                            {{ ph.habilidad.nombre }}
                                        </span>

                                        <div class="flex gap-1">

                                            {% for i in 1..5 %}

                                                {% if i <= ph.nivel %}
                                                    {# Puntos como circulitos #}
                                                    <span class="inline-block w-4 h-4 rounded-full bg-black"></span>

                                                {% else %}

                                                    <span class="inline-block w-4 h-4 rounded-full border border-black"></span>

                                                {% endif %}

                                            {% endfor %}

                                        </div>
                                    </div>

                                {% endif %}

                            {% endfor %}

                        </div>

                    </div>

                {% endfor %}

            </div>

        </section>


        {# ==========
           DISCIPLINAS
           ========== #}

        {# ==========
           TRASFONDOS
           ========== #}

        {# ==========
           VIRTUDES
           ========== #}

        {# ==========
           HUMANIDAD
           ========== #}

    </div>
</div>

{% endblock %}