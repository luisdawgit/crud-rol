{% extends 'base.html.twig' %}

{% block body %}

<div class="min-h-screen bg-gray-100">

    <div class="max-w-7xl mx-auto px-6 py-8">

        <a href="{{ path('app_personaje_index') }}"
            class="inline-flex items-center text-red-700 hover:text-red-900 font-medium mb-6">
            ← Volver a mis personajes
        </a>

        {# ==============================
           CABECERA DEL PERSONAJE
           ============================== #}
        <section class="bg-white rounded-xl shadow-lg p-8 mb-8">

            <div class="flex justify-between items-start">

                <div>

                    <h1 class="text-5xl font-serif text-red-900 mb-4">
                        {{ personaje.nombre }}
                    </h1>

                    <div class="flex gap-8 text-lg">

                        <div>
                            <span class="font-semibold">Clan:</span>
                            <span class="text-red-700">
                                {{ personaje.clan.nombre }}
                            </span>
                        </div>

                        <div>
                            <span class="font-semibold">Naturaleza:</span>
                            <span class="text-red-700">
                                {{ personaje.naturaleza }}
                            </span>
                        </div>

                        <div>
                            <span class="font-semibold">Conducta:</span>
                            <span class="text-red-700">
                                {{ personaje.conducta }}
                            </span>
                        </div>

                        <div>
                            <span class="font-semibold">Concepto:</span>
                            <span class="text-red-700">
                                {{ personaje.concepto }}
                            </span>
                        </div>

                        <div>
                            <span class="font-semibold">
                                Experiencia:
                            </span>
                            {{ personaje.experiencia }}
                        </div>

                    </div>

                </div>

                {# Aquí podremos colocar más adelante
                   el símbolo del clan o una ilustración #}

                <div class="text-gray-300 text-7xl">
                    🦇
                </div>

            </div>

        </section>

        {# ==========
           ATRIBUTOS
           ========== #}
        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-center text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Atributos
            </h2>

            {% set categorias = ['Fisico','Social','Mental'] %}

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                {% for cat in categorias %}

                    <div>

                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            {{ cat }}
                        </h3>

                        <div class="space-y-3">

                            {% for pa in personaje.personajeAtributos %}

                                {% if pa.atributo.categoria == cat %}

                                    <div class="flex justify-between items-center">

                                        <span class="text-gray-700">
                                            {{ pa.atributo.nombre }}
                                        </span>

                                        <div class="flex gap-1">

                                            {% for i in 1..5 %}

                                                {% if i <= pa.nivel %}
                                                    {# Puntos como circulitos #}
                                                    <span class="inline-block w-3 h-3 rounded-full bg-black"></span>

                                                {% else %}

                                                    <span class="inline-block w-3 h-3 rounded-full border border-black"></span>

                                                {% endif %}

                                            {% endfor %}

                                        </div>
                                    </div>

                                {% endif %}

                            {% endfor %}

                        </div>

                    </div>

                {% endfor %}

            </div>
        </section>


        {# ==========
           HABILIDADES
           ========== #}
        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-center text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Habilidades
            </h2>

            {% set categorias = ['Talentos','Tecnicas','Conocimientos'] %}

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                {% for cat in categorias %}

                    <div>

                        <h3 class="text-xl font-bold text-gray-800 mb-4">
                            {{ cat }}
                        </h3>

                        <div class="space-y-3">

                            {% for ph in personaje.personajeHabilidades %}

                                {% if ph.habilidad.categoria == cat %}

                                    <div class="flex justify-between items-center">

                                        <span class="text-gray-700">
                                            {{ ph.habilidad.nombre }}
                                        </span>

                                        <div class="flex gap-1">

                                            {% for i in 1..5 %}

                                                {% if i <= ph.nivel %}
                                                    {# Puntos como circulitos #}
                                                    <span class="inline-block w-3 h-3 rounded-full bg-black"></span>

                                                {% else %}

                                                    <span class="inline-block w-3 h-3 rounded-full border border-black"></span>

                                                {% endif %}

                                            {% endfor %}

                                        </div>
                                    </div>

                                {% endif %}

                            {% endfor %}

                        </div>

                    </div>

                {% endfor %}

            </div>
        </section>


        {# ====================
           --- VENTAJAS ---
           ==================== #}
        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Ventajas
            </h2>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

                {# =====================
                DISCIPLINAS
                ===================== #}
                <div>

                    <h3 class="text-xl font-bold text-gray-800 mb-4">
                        Disciplinas
                    </h3>

                    <div class="space-y-3">

                        {% for pd in personaje.personajeDisciplinas %}

                            <div class="flex items-center gap-3">

                                <span class="inline-block w-40 text-gray-700">{{ pd.disciplina.nombre }}</span>

                                <div class="flex gap-1">

                                    {% for i in 1..5 %}
                                        {% if i <= pd.nivel %}
                                            <span class="inline-block w-3 h-3 rounded-full bg-black"></span>
                                        {% else %}
                                            <span class="inline-block w-3 h-3 rounded-full border border-black"></span>
                                        {% endif %}
                                    {% endfor %}

                                </div>

                            </div>

                        {% else %}

                            <p class="text-gray-500">
                                No tiene disciplinas
                            </p>

                        {% endfor %}

                    </div>

                </div>


                {# =====================
                TRASFONDOS
                ===================== #}
                <div>

                    <h3 class="text-xl font-bold text-gray-800 mb-4">
                        Trasfondos
                    </h3>

                    <div class="space-y-3">

                        {% for pt in personaje.personajeTrasfondos %}

                            <div class="flex items-center gap-3">

                                <span class="inline-block w-40 text-gray-700">{{ pt.trasfondo.nombre }}</span>

                                <div class="flex gap-1">

                                    {% for i in 1..5 %}
                                        {% if i <= pt.nivel %}
                                            <span class="inline-block w-3 h-3 rounded-full bg-black"></span>
                                        {% else %}
                                            <span class="inline-block w-3 h-3 rounded-full border border-black"></span>
                                        {% endif %}
                                    {% endfor %}

                                </div>

                            </div>

                        {% else %}

                            <p class="text-gray-500">
                                No tiene trasfondos
                            </p>

                        {% endfor %}

                    </div>

                </div>


                {# =====================
                VIRTUDES
                ===================== #}
                <div>

                    <h3 class="text-xl font-bold text-gray-800 mb-4">
                        Virtudes
                    </h3>

                    <div class="space-y-3">

                        {% for pv in personaje.personajeVirtudes %}

                            <div class="flex items-center gap-3">

                                <span class="inline-block w-40 text-gray-700">{{ pv.virtud.nombre }}</span>

                                <div class="flex gap-1">

                                    {% for i in 1..5 %}
                                        {% if i <= pv.nivel %}
                                            <span class="inline-block w-3 h-3 rounded-full bg-black"></span>
                                        {% else %}
                                            <span class="inline-block w-3 h-3 rounded-full border border-black"></span>
                                        {% endif %}
                                    {% endfor %}

                                </div>

                            </div>

                        {% else %}

                            <p class="text-gray-500">
                                No tiene virtudes
                            </p>

                        {% endfor %}

                    </div>

                </div>

            </div>

        </section>


        {# ====================
            --- ESTADO DEL PERSONAJE ---
            ==================== #}
        <section class="bg-white rounded-xl shadow-md p-6 mb-8">

            <h2 class="text-center text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                Estado del personaje
            </h2>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Columna izquierda -->
                <div class="lg:col-span-1">
                    <section class="bg-white rounded-xl shadow-md p-6 mb-8">
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">
                            Meritos y defectos
                            </h3>
                            <p>
                                Se añadira mas tarde
                            </p>
                        </div>
                    </section>
                </div>

                <!-- Columna central (ocupa dos columnas) -->
                <div class="lg:col-span-1">
                    <section class="bg-white rounded-xl shadow-md p-6 mb-8">

                        {# === Humanidad === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            {% set humanidad = 0 %}
                            {% for pv in personaje.personajeVirtudes %}
                                {% if pv.virtud.nombre in ['Autocontrol', 'Conciencia'] %}
                                    {% set humanidad = humanidad + pv.nivel %}
                                {% endif %}
                            {% endfor %}

                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Humanidad
                            </h2>

                            <div class="flex flex-col items-center justify-center gap-3">
                                <div class="flex gap-1">
                                    {% for i in 1..10 %}
                                        {% if i <= humanidad %}
                                            <span class="inline-block w-4 h-4 rounded-full bg-black"></span>
                                        {% else %}
                                            <span class="inline-block w-4 h-4 rounded-full border border-black"></span>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                <p class="text-4xl font-bold text-red-900">
                                    {{ humanidad }}
                                </p>
                            </div>
                            <div class="rounded-xl p-1 bg-slate-50 mt-4">
                                <p class="text-sm text-gray-500 mt-2 text-center">
                                    Autocontrol + Conciencia
                                </p>
                            </div>
                        </div>

                        {# === Fuerza de voluntad === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            {% set fuerzaVoluntad = 0 %}
                            {% for pv in personaje.personajeVirtudes %}
                                {% if pv.virtud.nombre in ['Autocontrol', 'Coraje'] %}
                                    {% set fuerzaVoluntad = fuerzaVoluntad + pv.nivel %}
                                {% endif %}
                            {% endfor %}

                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Fuerza de Voluntad
                            </h2>

                            <div class="flex flex-col items-center justify-center gap-3">
                                <div class="flex gap-1">
                                    {% for i in 1..10 %}
                                        {% if i <= fuerzaVoluntad %}
                                            <span class="inline-block w-4 h-4 rounded-full bg-black"></span>
                                        {% else %}
                                            <span class="inline-block w-4 h-4 rounded-full border border-black"></span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="flex gap-1">
                                    {% for i in 1..10 %}
                                        {% if i <= fuerzaVoluntad %}
                                            <span class="inline-block w-4 h-4 border border-black"></span>
                                        {% else %}
                                            <span class="inline-block w-4 h-4 border border-black"></span>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                <p class="text-4xl font-bold text-red-900">
                                    {{ fuerzaVoluntad }}
                                </p>
                            </div>

                            <div class="rounded-xl p-1 bg-slate-50 mt-4">
                                <p class="text-sm text-gray-500 mt-2 text-center">
                                Autocontrol + Coraje 
                                </p>
                            </div>
                        </div>


                        {# === Reserva de sangre === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Reserva de sangre
                            </h2>
                            <div class="flex gap-1 items-center justify-center">
                                {% for i in 1..10 %}
                                    {% if i <= 10 %}
                                        <span class="inline-block w-4 h-4 border border-black"></span>
                                    {% else %}
                                        <span class="inline-block w-4 h-4 bg-black"></span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                </div>
                
                <!-- Columna derecha -->
                <div class="lg:col-span-1">
                    <section class="bg-white rounded-xl shadow-md p-6 mb-8">
                        {# === Salud === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Salud
                            </h2>
                            <div class="flex gap-1 items-center justify-center">
                                {% set nivelesSalud = [
                                    ['Magullado', '0'],
                                    ['Lastimado', '-1'],
                                    ['Lesionado', '-1'],
                                    ['Herido', '-2'],
                                    ['Malherido', '-2'],
                                    ['Tullido', '-5'],
                                    ['Incapacitado', '0']
                                ] %}

                                <div class="space-y-2">
                                    {% for nivel in nivelesSalud %}

                                    <div class="flex items-center justify-between py-1">

                                        <span class="w-40">
                                            {{ nivel[0] }}
                                        </span>

                                        <span class="w-10 text-center font-semibold">
                                            {{ nivel[1] }}
                                        </span>

                                        <span class="inline-block w-5 h-5 border-2 border-black"></span>

                                    </div>

                                    {% endfor %}

                                </div>
                            </div>
                        </div>

                        {# === Debilidad de clan === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Debilidad de clan
                            </h2>
                            <div class="flex gap-1 items-center justify-center">
                                {{ personaje.clan.debilidad|default('Sin debilidad registrada') }}
                            </div>
                        </div>

                        {# === Experiencia === #}
                        <div class="rounded-lg border border-slate-200 p-5 bg-slate-50 mt-6">
                            <h2 class="text-2xl font-semibold text-red-800 border-b pb-2 mb-6">
                                Experiencia
                            </h2>
                            <div class="flex gap-1 items-center justify-center">
                               {{ personaje.experiencia }}
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </section>

    </div>
</div>

{% endblock %}