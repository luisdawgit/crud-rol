{% extends 'base.html.twig' %}

{% block title %}Personaje index{% endblock %}

{% block body %}

<div class="max-w-6xl mx-auto p-6">

    <div class="flex justify-between items-center mb-6">

        <h1 class="text-3xl font-bold">
            Mis Personajes
        </h1>

        <a
            href="{{ path('app_personaje_new') }}"
            class="bg-red-700 text-white px-4 py-2 rounded hover:bg-red-800"
        >
            + Nuevo personaje
        </a>

    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">

        <table class="w-full">

            <thead class="bg-slate-800 text-white">

                <tr>
                    <th class="p-3 text-left">Nombre</th>
                    <th class="p-3 text-left">Clan</th>
                    <th class="p-3 text-left">Experiencia</th>
                    <th class="p-3 text-left">Acciones</th>
                    <th class="p-3 text-left"></th>
                </tr>

            </thead>

            <tbody>

            {% for personaje in personajes %}

                <tr class="border-b">

                    <td class="p-3">{{ personaje.nombre }}</td>

                    <td class="p-3">{{ personaje.clan }}</td>

                    <td class="p-3">{{ personaje.experiencia }}</td>

                    <td class="p-3 space-x-3">

                        <a
                            href="{{ path('app_personaje_show', {'id': personaje.id}) }}"
                            class="text-blue-600 hover:underline"
                        >
                            Ver
                        </a>

                        <a
                            href="{{ path('app_personaje_edit', {'id': personaje.id}) }}"
                            class="text-green-600 hover:underline"
                        >
                            Editar
                        </a>

                        <td class="p-3">
                            {{ include('personaje/_delete_form.html.twig') }}
                        </td>

                    </td>

                </tr>

            {% else %}

                <tr>

                    <td colspan="4" class="p-6 text-center text-gray-500">
                        No hay personajes todavía
                    </td>

                </tr>

            {% endfor %}

            </tbody>

        </table>

    </div>

</div>

{% endblock %}
