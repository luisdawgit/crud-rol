<form method="post"
      action="{{ path('app_personaje_delete', {'id': personaje.id}) }}"
      onsubmit="return confirm('¿Seguro que deseas borrar este personaje?');"
      class="inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ personaje.id) }}">
    <button class="bg-red-700 text-white px-3 py-1 rounded hover:bg-red-800">
        Borrar
    </button>
    
</form>
